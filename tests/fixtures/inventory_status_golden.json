{
  "about": "Shared document-inventory status fixture (SPEC-CLI-006, 2026-09-27). MRAG Plus holds the canonical copy at quality/golden/inventory-status.json; OSS mrag keeps a byte-identical copy at tests/fixtures/inventory_status_golden.json. Facts are product-neutral: each suite builds its own inputs from them and lets its implementation decide.",
  "profile": "default",
  "other_profile": "other",
  "aggregate_priority": [
    "excluded",
    "error",
    "pending",
    "indexing",
    "stale",
    "fallback",
    "indexed",
    "ready"
  ],
  "row_fields": [
    "document_id",
    "display_name",
    "source_identity",
    "source_binding_status",
    "content_hash",
    "status",
    "source_status",
    "index_status",
    "retrieval_status",
    "profile",
    "exclusion_id",
    "created_at",
    "updated_at",
    "ingest_ms"
  ],
  "envelope_fields": [
    "schema_version",
    "status",
    "profile",
    "filter",
    "total",
    "returned",
    "page",
    "documents"
  ],
  "filter_fields": [
    "all",
    "statuses"
  ],
  "page_fields": [
    "limit",
    "offset",
    "count",
    "next_offset"
  ],
  "oss_differences": {
